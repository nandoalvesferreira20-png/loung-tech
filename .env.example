# EXAMPLES ONLY. Never deploy this file or copy its secrets into public scripts.
# Existing root .env is preserved. Local values are not automatically Edge secrets.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
# Public settings go into orcamento/config.js after configuration/testing:
LEADS_FUNCTION_URL=https://your-project.supabase.co/functions/v1/submit-lead
TURNSTILE_SITE_KEY=your_public_site_key

# Supabase injects SUPABASE_URL and SUPABASE_SECRET_KEYS (JSON dictionary).
# Legacy injected SUPABASE_SERVICE_ROLE_KEY is supported as fallback.
# Do not create custom secrets with the reserved SUPABASE_ prefix.
RESEND_API_KEY=re_example_only
RESEND_FROM_EMAIL=Loung Tech <orcamentos@example.com>
LEADS_NOTIFICATION_EMAIL=team@example.com
TURNSTILE_SECRET_KEY=your_private_turnstile_secret
ALLOWED_ORIGINS=https://loung-tech.vercel.app
TURNSTILE_HOSTNAMES=loung-tech.vercel.app
LEADS_RATE_LIMIT_SECRET=replace_with_at_least_32_random_characters
LEADS_RETRY_SECRET=replace_with_a_different_random_secret_of_at_least_32_characters
LEADS_ENABLED=false
PRIVACY_POLICY_APPROVED=false
